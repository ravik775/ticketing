{
  "uid": "ticketing-overview",
  "title": "Ticketing - SLOs, tenants, data integrity and security",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {"type": "stat", "title": "API availability (1h, target 99.5 %)", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.995}]}}},
     "targets": [{"expr": "1 - slo:api_error_ratio:rate1h", "refId": "A"}]},
    {"type": "stat", "title": "API requests within 1 s (30m, target 99 %)", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.99}]}}},
     "targets": [{"expr": "slo:api_latency_good_ratio:rate30m", "refId": "A"}]},
    {"type": "stat", "title": "Outbox: pending / dead", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "ticketing_outbox_pending", "legendFormat": "pending", "refId": "A"}, {"expr": "ticketing_outbox_dead", "legendFormat": "dead", "refId": "B"}]},
    {"type": "stat", "title": "Firing alerts (excluding Watchdog)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
     "targets": [{"expr": "count(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}) or vector(0)", "refId": "A"}]},
    {"type": "timeseries", "title": "API requests/s by status (Kong)", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (code) (rate(kong_http_requests_total{service=\"ticket-service\"}[5m]))", "legendFormat": "{{code}}", "refId": "A"}]},
    {"type": "timeseries", "title": "API latency p50 / p95 / p99 (service)", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [
       {"expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/api.*\"}[5m])))", "legendFormat": "p50", "refId": "A"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/api.*\"}[5m])))", "legendFormat": "p95", "refId": "B"},
       {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/api.*\"}[5m])))", "legendFormat": "p99", "refId": "C"}]},
    {"type": "timeseries", "title": "Requests/s per tenant (noisy neighbours)", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (tenant) (rate(ticketing_tenant_requests_total[5m]))", "legendFormat": "{{tenant}}", "refId": "A"},
                 {"expr": "sum by (tenant) (rate(ticketing_tenant_throttled_total[5m]))", "legendFormat": "{{tenant}} throttled", "refId": "B"}]},
    {"type": "timeseries", "title": "Outbox backlog and oldest pending age (s)", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "ticketing_outbox_pending", "legendFormat": "pending", "refId": "A"},
                 {"expr": "ticketing_outbox_oldest_pending_age_seconds", "legendFormat": "oldest age s", "refId": "B"},
                 {"expr": "increase(ticketing_outbox_publish_failures_total[5m])", "legendFormat": "publish failures (5m)", "refId": "C"}]},
    {"type": "table", "title": "Certificates: days until expiry", "gridPos": {"x": 0, "y": 20, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "(certmanager_certificate_expiration_timestamp_seconds - time()) / 86400", "format": "table", "instant": true, "refId": "A"}]},
    {"type": "table", "title": "Pod restarts (last 1h)", "gridPos": {"x": 8, "y": 20, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "increase(kube_pod_container_status_restarts_total[1h]) > 0", "format": "table", "instant": true, "refId": "A"}]},
    {"type": "table", "title": "Firing alerts", "gridPos": {"x": 16, "y": 20, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "ALERTS{alertstate=\"firing\"}", "format": "table", "instant": true, "refId": "A"}]},
    {"type": "timeseries", "title": "SIEM: WAF blocked/flagged requests (per 5m)", "gridPos": {"x": 0, "y": 28, "w": 8, "h": 8},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"expr": "sum(count_over_time({namespace=\"edge\", container=\"waf\"} |= \"\\\"transaction\\\"\" [5m]))", "refId": "A"}]},
    {"type": "timeseries", "title": "SIEM: failed logins by realm (per 5m)", "gridPos": {"x": 8, "y": 28, "w": 8, "h": 8},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"expr": "sum(count_over_time({namespace=\"auth\", container=\"keycloak\"} |= \"LOGIN_ERROR\" |~ \"master\" [5m]))", "legendFormat": "master (admin)", "refId": "A"},
                 {"expr": "sum(count_over_time({namespace=\"auth\", container=\"keycloak\"} |= \"LOGIN_ERROR\" |~ \"ticketing\" [5m]))", "legendFormat": "ticketing", "refId": "B"}]},
    {"type": "timeseries", "title": "Backup age (hours)", "gridPos": {"x": 16, "y": 28, "w": 8, "h": 8},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"expr": "max by (db) (max_over_time({container=\"backup\"} |= \"backup status\" | regexp \"db=(?P<db>[a-z]+) base_age_seconds=(?P<age>[0-9]+)\" | unwrap age [15m])) / 3600", "legendFormat": "{{db}}", "refId": "A"}]},
    {"type": "logs", "title": "SIEM: Kubernetes audit - secrets, exec, port-forward (non-system users)", "gridPos": {"x": 0, "y": 36, "w": 24, "h": 9},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"expr": "{job=\"kubernetes-audit\"} | json | user_username!~\"system:.*\" | objectRef_resource=\"secrets\" or objectRef_subresource=~\"exec|portforward|attach\"", "refId": "A"}]}
  ]
}
